rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================
    // Helper Functions
    // =========================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data;
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        getUserData().role == 'superAdmin' ||
        request.auth.token.email in ['joeljoy1237@gmail.com']
      );
    }

    function isAbheriAdmin() {
      return isAuthenticated() && (
        isSuperAdmin() ||
        getUserData().role == 'abheriAdmin'
      );
    }


    // =========================================================
    // Users Collection
    // =========================================================

    match /users/{userId} {

      // Authenticated users can read profiles
      allow read: if isAuthenticated();

      // User can create/update their own profile
      // Super Admin can also create/update profiles
      allow create, update: if isOwner(userId) || isSuperAdmin();

      // Only Super Admin can delete users
      allow delete: if isSuperAdmin();
    }


    // =========================================================
    // Events Collection
    // =========================================================

    match /events/{eventId} {

      // Public read access
      allow read: if true;

      // Only event admins can create/update/delete events.
      // Department admins may only modify events belonging to their department.
      allow create: if isSuperAdmin() || (
        isAuthenticated() &&
        getUserData().role == 'admin' &&
        request.resource.data.department == getUserData().department
      );

      allow update: if isSuperAdmin() || (
        isAuthenticated() &&
        getUserData().role == 'admin' &&
        request.resource.data.department == getUserData().department
      );

      allow delete: if isSuperAdmin() || (
        isAuthenticated() &&
        getUserData().role == 'admin' &&
        resource.data.department == getUserData().department
      );
    }


    // =========================================================
    // General Event Registrations
    // =========================================================

    match /registrations/{regId} {

      // A logged-in user can register only themselves, and only while
      // the selected event is open. Free and paid registrations are both supported.
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && exists(/databases/$(database)/documents/events/$(request.resource.data.eventId))
        && (
          !('registrationOpen' in get(/databases/$(database)/documents/events/$(request.resource.data.eventId)).data)
          || get(/databases/$(database)/documents/events/$(request.resource.data.eventId)).data.registrationOpen == true
        )
        && request.resource.data.status in ['registered', 'paid', 'pending'];

      // Users can read their own registration; admins can read their events.
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isSuperAdmin() ||
        getUserData().role == 'admin'
      );

      // Users can update their own registration; admins can update registrations.
      allow update: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isSuperAdmin() ||
        getUserData().role == 'admin'
      );

      allow delete: if isSuperAdmin();
    }


// =========================================================
// Abheri - Battle of Bands Registrations
// =========================================================

match /abheri_registrations/{regId} {

  // -------------------------------------------------------
  // CREATE
  // -------------------------------------------------------
  // A normal user can create ONLY their own document.
  // The document ID must be their Firebase UID.
  // A second document cannot be created for the same user.
  //
  // Registration must also be OPEN.

  allow create: if isAuthenticated()
    && regId == request.auth.uid
    && request.resource.data.userId == request.auth.uid
    && !exists(
      /databases/$(database)/documents/abheri_registrations/$(request.auth.uid)
    )
    && (
      isAbheriAdmin()
      ||
      get(
        /databases/$(database)/documents/eventSettings/abheri
      ).data.registrationOpen == true
    );


  // -------------------------------------------------------
  // READ
  // -------------------------------------------------------
  // Users can read ONLY their own registration.
  // Abheri Admin / Super Admin can read all.

  allow read: if isAuthenticated() && (
    regId == request.auth.uid ||
    isAbheriAdmin()
  );


  // -------------------------------------------------------
  // UPDATE
  // -------------------------------------------------------
  // Normal users can update ONLY their own registration.
  // Admins can update any Abheri registration.

  allow update: if isAuthenticated() && (
    isAbheriAdmin()
    ||
    (
      regId == request.auth.uid
      &&
      resource.data.userId == request.auth.uid
      &&
      request.resource.data.userId == request.auth.uid
      &&
      get(
        /databases/$(database)/documents/eventSettings/abheri
      ).data.registrationOpen == true
    )
  );


  // -------------------------------------------------------
  // DELETE
  // -------------------------------------------------------
  // Only Super Admin can delete registrations.

  allow delete: if isSuperAdmin();
}


    // =========================================================
    // Abheri Registration Settings
    // =========================================================
    //
    // This document controls whether Abheri registration
    // is currently OPEN or CLOSED.
    //
    // Firestore document:
    //
    // eventSettings
    //      └── abheri
    //           └── registrationOpen: true / false
    //
    // =========================================================

    match /eventSettings/{settingId} {

      // Registration page can read the status
      // to show OPEN or CLOSED.
      allow read: if true;

      // Only Abheri Admin and Super Admin can
      // create or change the registration status.
      allow create, update: if isAbheriAdmin();

      // Only Super Admin can delete the settings.
      allow delete: if isSuperAdmin();
    }

  }
}