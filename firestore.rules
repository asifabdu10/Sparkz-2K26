rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================
    // HELPER FUNCTIONS
    // =========================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated()
        && request.auth.uid == userId;
    }

    function getUserData() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data;
    }

    function isAbheriRegistrationOpen() {
      return !exists(/databases/$(database)/documents/eventSettings/abheri)
        ||
        !(
          'registrationOpen' in get(
            /databases/$(database)/documents/eventSettings/abheri
          ).data
        )
        ||
        get(
          /databases/$(database)/documents/eventSettings/abheri
        ).data.registrationOpen == true;
    }

    function isEventRegistrationOpen(eventId) {
      return exists(/databases/$(database)/documents/events/$(eventId))
        && (
          // Spot registration mode
          (
            ('registrationMode' in get(/databases/$(database)/documents/events/$(eventId)).data)
            && get(/databases/$(database)/documents/events/$(eventId)).data.registrationMode == 'spot'
            && ('spotRegistrationOpen' in get(/databases/$(database)/documents/events/$(eventId)).data)
            && get(/databases/$(database)/documents/events/$(eventId)).data.spotRegistrationOpen == true
            && (
              !('spotRegistrationStartsAt' in get(/databases/$(database)/documents/events/$(eventId)).data)
              || get(/databases/$(database)/documents/events/$(eventId)).data.spotRegistrationStartsAt == null
              || !(get(/databases/$(database)/documents/events/$(eventId)).data.spotRegistrationStartsAt is timestamp)
              || get(/databases/$(database)/documents/events/$(eventId)).data.spotRegistrationStartsAt <= request.time
            )
          )
          ||
          // Online registration mode (default if registrationMode is missing or not 'spot'/'none')
          (
            (
              !('registrationMode' in get(/databases/$(database)/documents/events/$(eventId)).data)
              || get(/databases/$(database)/documents/events/$(eventId)).data.registrationMode == 'online'
            )
            && (
              !('registrationOpen' in get(/databases/$(database)/documents/events/$(eventId)).data)
              || get(/databases/$(database)/documents/events/$(eventId)).data.registrationOpen == true
            )
          )
        );
    }

    // =========================================================
    // SUPER ADMIN
    // =========================================================
    //
    // Super Admin is recognized either by:
    //
    // 1. users/{uid}.role == "superAdmin"
    //
    // OR
    //
    // 2. The configured Super Admin email.
    //
    // =========================================================

    function isSuperAdmin() {
      return isAuthenticated()
        && (
          (
            exists(/databases/$(database)/documents/users/$(request.auth.uid))
            &&
            'role' in get(
              /databases/$(database)/documents/users/$(request.auth.uid)
            ).data
            &&
            get(
              /databases/$(database)/documents/users/$(request.auth.uid)
            ).data.role == 'superAdmin'
          )
          ||
          request.auth.token.email
            in ['joeljoy1237@gmail.com']
        );
    }

    // =========================================================
    // ABHERI ADMIN
    // =========================================================

    function isAbheriAdmin() {
      return isAuthenticated()
        && (
          isSuperAdmin()
          ||
          (
            exists(/databases/$(database)/documents/users/$(request.auth.uid))
            &&
            'role' in get(
              /databases/$(database)/documents/users/$(request.auth.uid)
            ).data
            &&
            get(
              /databases/$(database)/documents/users/$(request.auth.uid)
            ).data.role == 'abheriAdmin'
          )
        );
    }


    // =========================================================
    // BASIC SCIENCE ADMIN
    // =========================================================

    function isBasicScienceAdmin() {
      return isAuthenticated()
        && (
          isSuperAdmin()
          ||
          (
            exists(/databases/$(database)/documents/users/$(request.auth.uid))
            &&
            'role' in get(
              /databases/$(database)/documents/users/$(request.auth.uid)
            ).data
            &&
            (
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'basicScienceAdmin'
              ||
              (
                get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
                &&
                'department' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data
                &&
                get(/databases/$(database)/documents/users/$(request.auth.uid)).data.department in [
                  'Basic Science & Humanities',
                  'Basic Science',
                  'BSH'
                ]
              )
            )
          )
        );
    }


    // =========================================================
    // ADMIN
    // =========================================================

    function isAdmin() {
      return isAuthenticated()
        && (
          isSuperAdmin()
          ||
          isBasicScienceAdmin()
          ||
          (
            exists(/databases/$(database)/documents/users/$(request.auth.uid))
            &&
            'role' in get(
              /databases/$(database)/documents/users/$(request.auth.uid)
            ).data
            &&
            get(
              /databases/$(database)/documents/users/$(request.auth.uid)
            ).data.role == 'admin'
          )
        );
    }


    // =========================================================
    // USERS
    // =========================================================

    match /users/{userId} {

      // -------------------------------------------------------
      // READ
      // -------------------------------------------------------
      //
      // Authenticated users can read profiles.
      //

      allow read: if isAuthenticated();


      // -------------------------------------------------------
      // CREATE / UPDATE
      // -------------------------------------------------------
      //
      // A user can create/update their own profile.
      //
      // Super Admin and Basic Science Admin can create/update user profile.
      //

      allow create, update: if
        isOwner(userId)
        ||
        isSuperAdmin()
        ||
        isBasicScienceAdmin();


      // -------------------------------------------------------
      // DELETE
      // -------------------------------------------------------
      //
      // Only Super Admin can delete users.
      //

      allow delete: if isSuperAdmin();
    }


    // =========================================================
    // EVENTS
    // =========================================================

    match /events/{eventId} {

      // Anyone can view events.
      allow read: if true;

      // Event creation is restricted to Super Admin.
      allow create: if isSuperAdmin();

      // Event editing, including opening/closing registration,
      // is restricted to Super Admin.
      allow update: if isSuperAdmin();

      // Event deletion is restricted to Super Admin.
      allow delete: if isSuperAdmin();
    }


    // =========================================================
    // GENERAL EVENT REGISTRATIONS
    // =========================================================

    match /registrations/{regId} {

      // -------------------------------------------------------
      // CREATE
      // -------------------------------------------------------
      //
      // NORMAL USER:
      // Can register only themselves.
      //
      // SUPER ADMIN:
      // Can register any existing user.
      //
      // Normal user registration also requires:
      // - Event exists
      // - Registration is open
      // - Valid registration status
      //
      // Super Admin registrations do not require the event
      // to be open because this is a manual admin registration.
      //

      allow create: if
        isAuthenticated()
        &&
        (
          isAdmin()
          ||
          (
            request.resource.data.userId == request.auth.uid
            &&
            isEventRegistrationOpen(request.resource.data.eventId)
          )
        )
        &&
        request.resource.data.status
          in [
            'registered',
            'paid',
            'pending'
          ];


      // -------------------------------------------------------
      // READ
      // -------------------------------------------------------
      //
      // User can read their own registrations.
      //
      // Super Admin and Admins (including Basic Science Admin) can read registrations.
      //

      allow read: if
        isAuthenticated()
        &&
        (
          resource == null
          ||
          resource.data.userId ==
            request.auth.uid
          ||
          isAdmin()
        );


      // -------------------------------------------------------
      // UPDATE
      // -------------------------------------------------------
      //
      // User can update their own registration.
      //
      // Admins can update any registration.
      //

      allow update: if
        isAuthenticated()
        &&
        (
          resource.data.userId ==
            request.auth.uid
          ||
          isAdmin()
        );


      // -------------------------------------------------------
      // DELETE
      // -------------------------------------------------------
      //
      // Only Super Admin can manually deregister users.
      //

      allow delete: if isSuperAdmin();
    }


    // =========================================================
    // ABHERI - BATTLE OF BANDS
    // =========================================================

    match /abheri_registrations/{regId} {

      // -------------------------------------------------------
      // CREATE
      // -------------------------------------------------------
      //
      // Normal user:
      // - Can create only their own registration
      // - Document ID must equal their UID
      // - Duplicate registration is prevented
      // - Abheri registration must be open
      //
      // Abheri Admin / Super Admin can also create.
      //

      allow create: if
        isSuperAdmin()

        ||

        (
          isAuthenticated()

          &&

          regId ==
            request.auth.uid

          &&

          request.resource.data.userId ==
            request.auth.uid

        &&

        !exists(
          /databases/$(database)/documents/abheri_registrations/$(request.auth.uid)
        )

        &&

        (
          isAbheriAdmin()

          ||

          isAbheriRegistrationOpen()
        )
        );


      // -------------------------------------------------------
      // READ
      // -------------------------------------------------------
      //
      // User can read their own Abheri registration.
      //
      // Abheri Admin / Super Admin / Admin can read all.
      //

      allow read: if
        isAuthenticated()
        &&
        (
          regId ==
            request.auth.uid

          ||

          resource.data.userId ==
            request.auth.uid

          ||

          isAbheriAdmin()

          ||

          isAdmin()
        );


      // -------------------------------------------------------
      // UPDATE
      // -------------------------------------------------------
      //
      // Abheri Admin / Super Admin can update any registration.
      //
      // User can update their own registration while
      // Abheri registration is open.
      //

      allow update: if
        isAuthenticated()
        &&
        (
          isAbheriAdmin()

          ||

          (
            regId ==
              request.auth.uid

            &&

            resource.data.userId ==
              request.auth.uid

            &&

            request.resource.data.userId ==
              request.auth.uid

            &&

            isAbheriRegistrationOpen()
          )
        );


      // -------------------------------------------------------
      // DELETE
      // -------------------------------------------------------
      //
      // Only Super Admin can manually deregister an Abheri
      // participant/band.
      //

      allow delete: if isSuperAdmin();
    }


    // =========================================================
    // ABHERI REGISTRATION SETTINGS
    // =========================================================

    match /eventSettings/{settingId} {

      // -------------------------------------------------------
      // READ
      // -------------------------------------------------------
      //
      // Anyone can read registration status.
      //

      allow read: if true;


      // -------------------------------------------------------
      // CREATE / UPDATE
      // -------------------------------------------------------
      //
      // Abheri Admin and Super Admin can change settings.
      //

      allow create, update: if isAbheriAdmin() || isAdmin();


      // -------------------------------------------------------
      // DELETE
      // -------------------------------------------------------
      //
      // Only Super Admin can delete settings.
      //

      allow delete: if isSuperAdmin();
    }


    // =========================================================
    // SYSTEM SETTINGS / MAINTENANCE MODE
    // =========================================================

    match /systemSettings/{settingId} {
      // Anyone can read system settings (e.g. maintenance mode check)
      allow read: if true;

      // Only Super Admin can change system settings
      allow write: if isSuperAdmin();
    }


    // =========================================================
    // VISITOR REGISTRATIONS
    // =========================================================
    //
    // Separate collection — never mixed with event registrations.
    // Public can create their own registration (via server API).
    // Only admins can read all records.
    // Proof documents are on Google Drive, admin-only via API.
    // =========================================================

    match /visitor_registrations/{regId} {

      // Super/Admin users may create direct/admin passes.
      // Regular authenticated users create their own visitor pass only after
      // the server has verified the Razorpay payment. The paid departmental
      // registration is checked here as an additional Firestore-side guard,
      // so Visitor Registration does not require Firebase Admin credentials.
      allow create: if
        isAdmin()
        ||
        (
          isAuthenticated()
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.approvalStatus == "approved"
          && request.resource.data.paymentStatus == "paid"
          && request.resource.data.amountPaid is number
          && request.resource.data.amountPaid > 0
          && request.resource.data.collegeIdFileId is string
          && request.resource.data.collegeIdFileId.size() > 0
          && request.resource.data.referringIdFileId is string
          && request.resource.data.referringIdFileId.size() > 0
          && request.resource.data.referringType in ["student", "faculty"]
          && request.resource.data.referringName is string
          && request.resource.data.referringName.size() > 1
          && request.resource.data.razorpayPaymentId is string
          && request.resource.data.razorpayPaymentId.size() > 0
          && request.resource.data.razorpayOrderId is string
          && request.resource.data.razorpayOrderId.size() > 0
          && request.resource.data.qualifyingRegistrationId is string
          && request.resource.data.qualifyingRegistrationId.size() > 0
          && get(/databases/$(database)/documents/registrations/$(request.resource.data.qualifyingRegistrationId)).data.userId == request.auth.uid
          && (
            get(/databases/$(database)/documents/registrations/$(request.resource.data.qualifyingRegistrationId)).data.paymentStatus == "paid"
            ||
            get(/databases/$(database)/documents/registrations/$(request.resource.data.qualifyingRegistrationId)).data.status == "paid"
          )
        );

      // Admins can read all; authenticated users can read their own.
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);

      // Admins can update any visitor record. A visitor may only update the
      // email-delivery fields on their own record after registration.
      allow update: if
        isAdmin()
        ||
        (
          isAuthenticated()
          && resource.data.userId == request.auth.uid
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "emailStatus",
            "emailSentAt",
            "emailError",
            "updatedAt"
          ])
        );

      // Only Super Admin can delete visitor registrations.
      allow delete: if isSuperAdmin();
    }


    // =========================================================
    // ALUMNI REGISTRATIONS
    // =========================================================
    //
    // Completely separate from visitor_registrations.
    // Alumni can create without authentication.
    // Only admins can read all records.
    // =========================================================

    match /alumni_registrations/{regId} {

      // All public registrations must go through secure server API (/api/alumni-registration/submit)
      // Direct client creation is restricted to admins.
      allow create: if isAdmin();

      // Admins can read all; authenticated users can read their own.
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);

      // Only admins can update alumni registration documents.
      allow update: if isAdmin();

      // Only Super Admin can delete alumni registrations.
      allow delete: if isSuperAdmin();
    }

  }
}