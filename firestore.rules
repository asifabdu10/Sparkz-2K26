rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================
    // Helper Functions
    // =========================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data;
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        getUserData().role == 'superAdmin' ||
        request.auth.token.email in ['joeljoy1237@gmail.com']
      );
    }

    function isAbheriAdmin() {
      return isAuthenticated() && (
        isSuperAdmin() ||
        getUserData().role == 'abheriAdmin'
      );
    }


    // =========================================================
    // USERS
    // =========================================================

    match /users/{userId} {

      // Authenticated users can read profiles
      allow read: if isAuthenticated();

      // User can create/update their own profile.
      // Super Admin can create/update any profile.
      allow create, update: if
        isOwner(userId) ||
        isSuperAdmin();

      // Only Super Admin can delete users.
      allow delete: if isSuperAdmin();
    }


    // =========================================================
    // EVENTS
    // =========================================================

    match /events/{eventId} {

      // Anyone can view events.
      allow read: if true;

      // -------------------------------------------------------
      // CREATE
      // -------------------------------------------------------

      allow create: if
        isSuperAdmin()
        ||
        (
          isAuthenticated() &&
          getUserData().role == 'admin' &&
          request.resource.data.department ==
            getUserData().department
        );


      // -------------------------------------------------------
      // UPDATE
      // -------------------------------------------------------

      allow update: if
        isSuperAdmin()
        ||
        (
          isAuthenticated() &&
          getUserData().role == 'admin' &&
          request.resource.data.department ==
            getUserData().department
        );


      // -------------------------------------------------------
      // DELETE
      // -------------------------------------------------------

      allow delete: if
        isSuperAdmin()
        ||
        (
          isAuthenticated() &&
          getUserData().role == 'admin' &&
          resource.data.department ==
            getUserData().department
        );
    }


    // =========================================================
    // GENERAL EVENT REGISTRATIONS
    // =========================================================

    match /registrations/{regId} {

      // -------------------------------------------------------
      // CREATE
      // -------------------------------------------------------
      //
      // User can create only their own registration.
      // Event must exist.
      // Event must be open.
      //

      allow create: if
        isAuthenticated()
        &&
        request.resource.data.userId ==
          request.auth.uid
        &&
        exists(
          /databases/$(database)/documents/events/$(request.resource.data.eventId)
        )
        &&
        (
          !(
            'registrationOpen'
            in get(
              /databases/$(database)/documents/events/$(request.resource.data.eventId)
            ).data
          )
          ||
          get(
            /databases/$(database)/documents/events/$(request.resource.data.eventId)
          ).data.registrationOpen == true
        )
        &&
        request.resource.data.status
          in ['registered', 'paid', 'pending'];


      // -------------------------------------------------------
      // READ
      // -------------------------------------------------------

      allow read: if
        isAuthenticated()
        &&
        (
          resource.data.userId ==
            request.auth.uid
          ||
          isSuperAdmin()
          ||
          getUserData().role == 'admin'
        );


      // -------------------------------------------------------
      // UPDATE
      // -------------------------------------------------------

      allow update: if
        isAuthenticated()
        &&
        (
          resource.data.userId ==
            request.auth.uid
          ||
          isSuperAdmin()
          ||
          getUserData().role == 'admin'
        );


      // -------------------------------------------------------
      // DELETE
      // -------------------------------------------------------
      //
      // Super Admin can manually deregister a user.
      //

      allow delete: if isSuperAdmin();
    }


    // =========================================================
    // ABHERI - BATTLE OF BANDS
    // =========================================================

    match /abheri_registrations/{regId} {

      // -------------------------------------------------------
      // CREATE
      // -------------------------------------------------------

      allow create: if
        isAuthenticated()
        &&
        regId == request.auth.uid
        &&
        request.resource.data.userId ==
          request.auth.uid
        &&
        !exists(
          /databases/$(database)/documents/abheri_registrations/$(request.auth.uid)
        )
        &&
        (
          isAbheriAdmin()
          ||
          get(
            /databases/$(database)/documents/eventSettings/abheri
          ).data.registrationOpen == true
        );


      // -------------------------------------------------------
      // READ
      // -------------------------------------------------------

      allow read: if
        isAuthenticated()
        &&
        (
          regId == request.auth.uid
          ||
          isAbheriAdmin()
        );


      // -------------------------------------------------------
      // UPDATE
      // -------------------------------------------------------

      allow update: if
        isAuthenticated()
        &&
        (
          isAbheriAdmin()
          ||
          (
            regId == request.auth.uid
            &&
            resource.data.userId ==
              request.auth.uid
            &&
            request.resource.data.userId ==
              request.auth.uid
            &&
            get(
              /databases/$(database)/documents/eventSettings/abheri
            ).data.registrationOpen == true
          )
        );


      // -------------------------------------------------------
      // DELETE
      // -------------------------------------------------------

      // Only Super Admin can delete Abheri registrations.
      allow delete: if isSuperAdmin();
    }


    // =========================================================
    // ABHERI REGISTRATION SETTINGS
    // =========================================================

    match /eventSettings/{settingId} {

      // Registration status can be read publicly.
      allow read: if true;

      // Only Abheri Admin / Super Admin can change settings.
      allow create, update: if isAbheriAdmin();

      // Only Super Admin can delete settings.
      allow delete: if isSuperAdmin();
    }

  }
}