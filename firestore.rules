rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================
    // HELPER FUNCTIONS
    // =========================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated()
        && request.auth.uid == userId;
    }

    function getUserData() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data;
    }

    // =========================================================
    // SUPER ADMIN
    // =========================================================
    //
    // Super Admin is recognized either by:
    //
    // 1. users/{uid}.role == "superAdmin"
    //
    // OR
    //
    // 2. The configured Super Admin email.
    //
    // =========================================================

    function isSuperAdmin() {
      return isAuthenticated()
        && (
          get(
            /databases/$(database)/documents/users/$(request.auth.uid)
          ).data.role == 'superAdmin'
          ||
          request.auth.token.email
            in ['joeljoy1237@gmail.com']
        );
    }

    // =========================================================
    // ABHERI ADMIN
    // =========================================================

    function isAbheriAdmin() {
      return isAuthenticated()
        && (
          isSuperAdmin()
          ||
          get(
            /databases/$(database)/documents/users/$(request.auth.uid)
          ).data.role == 'abheriAdmin'
        );
    }


    // =========================================================
    // USERS
    // =========================================================

    match /users/{userId} {

      // -------------------------------------------------------
      // READ
      // -------------------------------------------------------
      //
      // Authenticated users can read profiles.
      //

      allow read: if isAuthenticated();


      // -------------------------------------------------------
      // CREATE / UPDATE
      // -------------------------------------------------------
      //
      // A user can create/update their own profile.
      //
      // Super Admin can create/update any user profile.
      //

      allow create, update: if
        isOwner(userId)
        ||
        isSuperAdmin();


      // -------------------------------------------------------
      // DELETE
      // -------------------------------------------------------
      //
      // Only Super Admin can delete users.
      //

      allow delete: if isSuperAdmin();
    }


    // =========================================================
    // EVENTS
    // =========================================================

    match /events/{eventId} {

      // -------------------------------------------------------
      // READ
      // -------------------------------------------------------
      //
      // Anyone can view events.
      //

      allow read: if true;


      // -------------------------------------------------------
      // CREATE
      // -------------------------------------------------------
      //
      // Super Admin can create any event.
      //
      // Normal Admin can create events only for their
      // own department.
      //

      allow create: if
        isSuperAdmin()
        ||
        (
          isAuthenticated()
          &&
          get(
            /databases/$(database)/documents/users/$(request.auth.uid)
          ).data.role == 'admin'
          &&
          request.resource.data.department ==
            get(
              /databases/$(database)/documents/users/$(request.auth.uid)
            ).data.department
        );


      // -------------------------------------------------------
      // UPDATE
      // -------------------------------------------------------
      //
      // Super Admin can update any event.
      //
      // Normal Admin can update events only for their
      // own department.
      //

      allow update: if
        isSuperAdmin()
        ||
        (
          isAuthenticated()
          &&
          get(
            /databases/$(database)/documents/users/$(request.auth.uid)
          ).data.role == 'admin'
          &&
          request.resource.data.department ==
            get(
              /databases/$(database)/documents/users/$(request.auth.uid)
            ).data.department
        );


      // -------------------------------------------------------
      // DELETE
      // -------------------------------------------------------
      //
      // Super Admin can delete any event.
      //
      // Normal Admin can delete events only from their
      // own department.
      //

      allow delete: if
        isSuperAdmin()
        ||
        (
          isAuthenticated()
          &&
          get(
            /databases/$(database)/documents/users/$(request.auth.uid)
          ).data.role == 'admin'
          &&
          resource.data.department ==
            get(
              /databases/$(database)/documents/users/$(request.auth.uid)
            ).data.department
        );
    }


    // =========================================================
    // GENERAL EVENT REGISTRATIONS
    // =========================================================

    match /registrations/{regId} {

      // -------------------------------------------------------
      // CREATE
      // -------------------------------------------------------
      //
      // NORMAL USER:
      // Can register only themselves.
      //
      // SUPER ADMIN:
      // Can register any existing user.
      //
      // Normal user registration also requires:
      // - Event exists
      // - Registration is open
      // - Valid registration status
      //
      // Super Admin registrations do not require the event
      // to be open because this is a manual admin registration.
      //

      allow create: if
        isAuthenticated()
        &&
        (
          // ---------------------------------------------------
          // SUPER ADMIN REGISTRATION
          // ---------------------------------------------------
          isSuperAdmin()

          ||

          // ---------------------------------------------------
          // NORMAL USER REGISTRATION
          // ---------------------------------------------------
          (
            request.resource.data.userId ==
              request.auth.uid

            &&

            exists(
              /databases/$(database)/documents/events/$(request.resource.data.eventId)
            )

            &&

            (
              !(
                'registrationOpen'
                in get(
                  /databases/$(database)/documents/events/$(request.resource.data.eventId)
                ).data
              )

              ||

              get(
                /databases/$(database)/documents/events/$(request.resource.data.eventId)
              ).data.registrationOpen == true
            )
          )
        )

        &&

        request.resource.data.status
          in [
            'registered',
            'paid',
            'pending'
          ];


      // -------------------------------------------------------
      // READ
      // -------------------------------------------------------
      //
      // User can read their own registrations.
      //
      // Super Admin can read all registrations.
      //
      // Admin can read registrations.
      //

      allow read: if
        isAuthenticated()
        &&
        (
          resource.data.userId ==
            request.auth.uid

          ||

          isSuperAdmin()

          ||

          get(
            /databases/$(database)/documents/users/$(request.auth.uid)
          ).data.role == 'admin'
        );


      // -------------------------------------------------------
      // UPDATE
      // -------------------------------------------------------
      //
      // User can update their own registration.
      //
      // Super Admin can update any registration.
      //
      // Admin can update registrations.
      //

      allow update: if
        isAuthenticated()
        &&
        (
          resource.data.userId ==
            request.auth.uid

          ||

          isSuperAdmin()

          ||

          get(
            /databases/$(database)/documents/users/$(request.auth.uid)
          ).data.role == 'admin'
        );


      // -------------------------------------------------------
      // DELETE
      // -------------------------------------------------------
      //
      // Only Super Admin can manually deregister users.
      //

      allow delete: if isSuperAdmin();
    }


    // =========================================================
    // ABHERI - BATTLE OF BANDS
    // =========================================================

    match /abheri_registrations/{regId} {

      // -------------------------------------------------------
      // CREATE
      // -------------------------------------------------------
      //
      // Normal user:
      // - Can create only their own registration
      // - Document ID must equal their UID
      // - Duplicate registration is prevented
      // - Abheri registration must be open
      //
      // Abheri Admin / Super Admin can also create.
      //

      allow create: if
        isAuthenticated()

        &&

        regId ==
          request.auth.uid

        &&

        request.resource.data.userId ==
          request.auth.uid

        &&

        !exists(
          /databases/$(database)/documents/abheri_registrations/$(request.auth.uid)
        )

        &&

        (
          isAbheriAdmin()

          ||

          get(
            /databases/$(database)/documents/eventSettings/abheri
          ).data.registrationOpen == true
        );


      // -------------------------------------------------------
      // READ
      // -------------------------------------------------------
      //
      // User can read their own Abheri registration.
      //
      // Abheri Admin / Super Admin can read all.
      //

      allow read: if
        isAuthenticated()
        &&
        (
          regId ==
            request.auth.uid

          ||

          isAbheriAdmin()
        );


      // -------------------------------------------------------
      // UPDATE
      // -------------------------------------------------------
      //
      // Abheri Admin / Super Admin can update any registration.
      //
      // User can update their own registration while
      // Abheri registration is open.
      //

      allow update: if
        isAuthenticated()
        &&
        (
          isAbheriAdmin()

          ||

          (
            regId ==
              request.auth.uid

            &&

            resource.data.userId ==
              request.auth.uid

            &&

            request.resource.data.userId ==
              request.auth.uid

            &&

            get(
              /databases/$(database)/documents/eventSettings/abheri
            ).data.registrationOpen == true
          )
        );


      // -------------------------------------------------------
      // DELETE
      // -------------------------------------------------------
      //
      // Only Super Admin can manually deregister an Abheri
      // participant/band.
      //

      allow delete: if isSuperAdmin();
    }


    // =========================================================
    // ABHERI REGISTRATION SETTINGS
    // =========================================================

    match /eventSettings/{settingId} {

      // -------------------------------------------------------
      // READ
      // -------------------------------------------------------
      //
      // Anyone can read registration status.
      //

      allow read: if true;


      // -------------------------------------------------------
      // CREATE / UPDATE
      // -------------------------------------------------------
      //
      // Abheri Admin and Super Admin can change settings.
      //

      allow create, update: if isAbheriAdmin();


      // -------------------------------------------------------
      // DELETE
      // -------------------------------------------------------
      //
      // Only Super Admin can delete settings.
      //

      allow delete: if isSuperAdmin();
    }

  }
}